#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* エンコーダーの感度を下げて爆走を止める（独立して記述） */

&left_encoder { steps = <40>; };

&right_encoder { steps = <40>; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W                    &kp E         &kp R                   &kp T                                                                                  &kp Y                   &kp U  &kp I      &kp O    &kp P
&kp A             &kp S                    &kp D         &kp F                   &kp G                             &kp LS(LG(S))               &kp ASTERISK             &kp H                   &kp J  &kp K      &kp L    &kp SQT
&mt LEFT_SHIFT Z  &kp X                    &kp C         &kp V                   &kp B                             &kp MINUS                   &kp LEFT_PARENTHESIS     &kp N                   &kp M  &kp COMMA  &kp DOT  &lt 4 SLASH
&kp LEFT_CONTROL  &mt LEFT_SHIFT LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 5 GRAVE  &lt_to_layer_0 2 INTERNATIONAL_4  &lt_to_layer_0 3 SPACE      &mt BACKSPACE BACKSPACE  &lt_to_layer_0 1 ENTER                             &mt DEL DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        SYMBOL {
            bindings = <
&kp LEFT_BRACKET       &kp LEFT_BRACE  &kp RS(RBRC)  &kp RIGHT_BRACKET  &trans                      &trans  &trans  &kp ASTERISK  &kp LEFT_PARENTHESIS  &trans
&kp RIGHT_PARENTHESIS  &kp RS(TILDE)   &kp LCTRL     &trans             &trans  &trans      &trans  &trans  &trans  &trans        &kp BACKSLASH         &trans
&trans                 &trans          &trans        &trans             &trans  &trans      &trans  &trans  &trans  &trans        &trans                &trans
&trans                 &trans          &trans        &trans             &trans  &trans      &trans  &trans                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        NUMBER {
            bindings = <
&kp COMMA        &kp KP_NUMBER_7  &kp KP_NUMBER_8       &kp KP_NUMBER_9  &kp SLASH                                      &trans  &kp N7  &kp N8  &kp N9  &trans
&kp PERIOD       &kp KP_NUMBER_4  &kp KP_NUMBER_5       &kp KP_NUMBER_6  &kp DOUBLE_QUOTES  &kp KP_NUMLOCK      &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2       &kp KP_NUMBER_3  &kp MINUS          &kp COLON           &trans  &kp N0  &kp N1  &kp N2  &kp N3  &trans
&kp UNDERSCORE   &kp ASTERISK     &kp LEFT_PARENTHESIS  &trans           &trans             &trans              &trans  &trans                          &trans
            >;
        };

        ARROW_FUNCTION {
            bindings = <
&kp F1  &kp F2    &kp F3    &kp F4     &kp F5                      &kp F6  &kp F7    &kp F8    &kp F9     &kp F10
&trans  &trans    &kp UP    &trans     &trans  &trans      &trans  &trans  &trans    &kp UP    &trans     &kp F11
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans      &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp F12
&trans  &trans    &trans    &trans     &trans  &trans      &trans  &trans                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PG_UP) LC(PG_DN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &mkp MB5  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
